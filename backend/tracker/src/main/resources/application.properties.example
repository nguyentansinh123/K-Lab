spring.application.name=tracker

# --- Datasource (MySQL) ---
spring.datasource.url=jdbc:mysql://localhost:3306/studytracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USER:your_db_user}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
spring.jpa.hibernate.ddl-auto=create
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false
spring.jpa.defer-datasource-initialization=true
spring.sql.init.mode=always

# --- JWT ---
JWT_SECRET=your_jwt_secret_here
app.security.jwt.access-token-expiration=86400000
app.security.jwt.refresh-token-expiration=604800000

CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
